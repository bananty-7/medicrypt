# Copy this file to .env and adjust values before running in production.

ENV=development

# Leave as-is to use local SQLite (zero setup). For Postgres, use:
# DATABASE_URL=postgresql+psycopg2://medicrypt:medicrypt@db:5432/medicrypt
DATABASE_URL=sqlite:///./medicrypt.db

# Generate a strong random secret for production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=replace_this_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
